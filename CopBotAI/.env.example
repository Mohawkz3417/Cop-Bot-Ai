# Copy this file to .env and fill in the values you need.
# CopBot AI works with ZERO keys configured (it falls back to its built-in
# knowledge base), but for full AI-generated answers configure at least one
# of Groq or Ollama below.

# ---- App ----
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=*

# "auto" tries Groq first, then Ollama, then the local knowledge base.
# Set to "groq" or "ollama" to force a single provider.
DEFAULT_PROVIDER=auto

# ---- Groq (https://console.groq.com/keys) ----
# Fast, free-tier-friendly, hosted inference. Recommended for most users.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Ollama (https://ollama.com) ----
# Fully local / private inference. Install Ollama, then run:
#   ollama pull mistral
#   ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ---- Retrieval-augmented generation tuning ----
RAG_TOP_K=4
RAG_MIN_SCORE=0.12
RAG_DIRECT_ANSWER_SCORE=0.62

# ---- Limits ----
MAX_MESSAGE_LENGTH=2000
MAX_HISTORY_TURNS=12
REQUEST_TIMEOUT=60

# ---- Rate limiting (protects /api/chat/stream from abuse) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
